/* Python ETL Multitasker - light professional theme, Arabic RTL */
QWidget { font-size: 10.5pt; color: #1f2937; }
QMainWindow, #Content { background: #f3f5f9; }

/* sidebar */
#Sidebar { background: #111827; }
#Brand { color: #ffffff; font-size: 12.5pt; font-weight: 700; padding: 18px 16px 2px 16px; }
#BrandSub { color: #9ca3af; font-size: 9pt; padding: 0 16px 16px 16px; }
#NavList { background: transparent; border: none; outline: none; }
#NavList::item { color: #d1d5db; padding: 11px 18px; margin: 2px 10px; border-radius: 8px; }
#NavList::item:hover { background: #1f2937; color: #ffffff; }
#NavList::item:selected { background: #2563eb; color: #ffffff; }
#SidebarFooter { color: #6b7280; font-size: 8.5pt; padding: 12px 16px; }

/* headings */
#PageTitle { font-size: 17pt; font-weight: 700; color: #111827; }
#PageSubtitle { color: #6b7280; }
#SectionTitle { font-size: 11.5pt; font-weight: 700; color: #111827; }
#Muted { color: #6b7280; }

/* cards */
#Card { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; }
#StatValue { font-size: 22pt; font-weight: 700; color: #111827; }
#StatLabel { color: #6b7280; font-size: 9.5pt; }

/* buttons */
QPushButton { background: #ffffff; border: 1px solid #d1d5db; border-radius: 8px; padding: 7px 14px; }
QPushButton:hover { background: #f9fafb; border-color: #9ca3af; }
QPushButton:disabled { color: #9ca3af; background: #f3f4f6; }
QPushButton#Primary { background: #2563eb; border-color: #2563eb; color: #ffffff; font-weight: 600; }
QPushButton#Primary:hover { background: #1d4ed8; }
QPushButton#Danger { background: #ffffff; border-color: #fca5a5; color: #b91c1c; }
QPushButton#Danger:hover { background: #fef2f2; }

/* inputs */
QLineEdit, QDateEdit, QSpinBox, QComboBox { background: #ffffff; border: 1px solid #d1d5db; border-radius: 7px;
    padding: 6px 8px; min-height: 20px; }
QLineEdit:focus, QDateEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #2563eb; }
QRadioButton, QCheckBox { spacing: 8px; }

/* tables */
QTableWidget, QTreeWidget, QListWidget#TaskList { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px;
    gridline-color: #f1f5f9; selection-background-color: #dbeafe; selection-color: #111827; }
QHeaderView::section { background: #f8fafc; color: #374151; font-weight: 600; border: none;
    border-bottom: 1px solid #e5e7eb; padding: 7px 8px; }
QListWidget#TaskList::item { padding: 10px 8px; border-bottom: 1px solid #f1f5f9; }
QListWidget#TaskList::item:selected { background: #eff6ff; color: #1e3a8a; }

QPlainTextEdit#Log { background: #0b1220; color: #e5e7eb; border-radius: 10px; padding: 8px;
    font-family: Consolas, "Courier New", monospace; font-size: 9.5pt; }

/* banners */
#Banner { border-radius: 10px; padding: 10px 14px; }
#Banner[kind="ok"] { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
#Banner[kind="warn"] { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
#Banner[kind="error"] { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
#Banner[kind="info"] { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }

QScrollArea { border: none; background: transparent; }
QTabWidget::pane { border: 1px solid #e5e7eb; border-radius: 10px; background: #ffffff; }
QTabBar::tab { padding: 8px 16px; }
