*.xlsm

# Unreviewed local test samples (real exports must never be committed)
tests/fixtures/

# IDE files
.vscode/
.idea/

# Logs
*.log

# PyInstaller / build outputs (the application is published as a GitHub Release, not in git)
build/
dist/
build_new/
*.zip
